# Mock / bench configuration for boilerRoom-edge.
# Copy to .env and edit, or point at this file with a wrapper that exports its
# contents. Every variable the agent reads, with the value it falls back to
# when the variable is unset — see README.md and the module docstrings.

# --- Credentials & endpoints -------------------------------------------------
BOILERROOM_DEVICE_USERNAME=8000000001
BOILERROOM_DEVICE_PASSWORD=1234
BOILERROOM_API_BASE_URL=https://rsesco.ir
BOILERROOM_WS_BASE_URL=wss://rsesco.ir
BOILERROOM_WS_ORIGIN=
BOILERROOM_DEVICE_ID=

# --- Session / auth ----------------------------------------------------------
BOILERROOM_TOKEN_EXPIRY_BUFFER=60
BOILERROOM_WS_RECONNECT_DELAY=5
BOILERROOM_WS_RECONNECT_MAX_DELAY=60
BOILERROOM_WS_SESSION_STABLE=30

# --- Hardware selection ------------------------------------------------------
BOILERROOM_MOCK_HARDWARE=on
BOILERROOM_RELAY_GPIO=

# --- Mapping -----------------------------------------------------------------
BOILERROOM_MAPPING_SOURCE=record
BOILERROOM_MAPPING=mapping.json

# --- Caches (paths) ----------------------------------------------------------
BOILERROOM_CONFIG_CACHE=config_cache.json
BOILERROOM_CONFIG_LOCAL=config_local.json
BOILERROOM_SCHEDULE_CACHE=schedule_cache.json
BOILERROOM_SCHEDULE_LOCAL=schedule_local.json
BOILERROOM_MODE_CACHE=mode_cache.json
BOILERROOM_SETPOINT_CACHE=setpoint_cache.json
BOILERROOM_DEVICE_RECORD_CACHE=device_record_cache.json
BOILERROOM_DATABASE=data/readings.db
BOILERROOM_LOG_FILE=data/boilerroom.log

# --- Data / outbox -----------------------------------------------------------
BOILERROOM_DATA_RETENTION_DAYS=30
BOILERROOM_OUTBOX_MAX_PENDING=5000
BOILERROOM_OUTBOX_MAX_ATTEMPTS=5

# --- Logging -----------------------------------------------------------------
BOILERROOM_LOG_LEVEL=INFO
BOILERROOM_LOG_CONSOLE_LEVEL=OFF
BOILERROOM_LOG_LEVELS=
BOILERROOM_LOG_MAX_BYTES=2097152
BOILERROOM_LOG_BACKUPS=3

# --- Temperature limits ------------------------------------------------------
BOILERROOM_AMBIENT_HYSTERESIS=2.0
BOILERROOM_WATER_DEADBAND=5.0
BOILERROOM_SINGLE_PROBE_BAND=3.0

# --- Versions reported in device.hello --------------------------------------
BOILERROOM_FIRMWARE_VERSION=1.0.0
BOILERROOM_HARDWARE_VERSION=edge-dev

# --- Menu --------------------------------------------------------------------
BOILERROOM_MENU=auto

# --- Keypad ------------------------------------------------------------------
BOILERROOM_KEYPAD_ROWS=17,27,22,5
BOILERROOM_KEYPAD_COLS=6,13,19,26
BOILERROOM_KEYPAD_LAYOUT=
BOILERROOM_KEYPAD_CAPS=
BOILERROOM_KEYPAD_EMULATE=off

# --- Display (ST7920) --------------------------------------------------------
BOILERROOM_DISPLAY_SPI_BUS=0
BOILERROOM_DISPLAY_SPI_DEVICE=1
BOILERROOM_DISPLAY_SPI_SPEED=500000
BOILERROOM_DISPLAY_SPI_MODE=3
BOILERROOM_DISPLAY_CS_PIN=7
BOILERROOM_DISPLAY_PSB_PIN=none
BOILERROOM_DISPLAY_CLEAR_ON_EXIT=on
BOILERROOM_DISPLAY_SELFTEST=off
BOILERROOM_DISPLAY_COMMAND_DELAY=0.001
BOILERROOM_DISPLAY_DATA_DELAY=0.0
BOILERROOM_DISPLAY=mock